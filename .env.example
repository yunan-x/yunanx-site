# Neon Postgres via the Vercel Marketplace. Vercel injects both on deploy;
# locally, `npx vercel env pull .env` fills them in.
# DATABASE_URL is the pooled string (runtime). DATABASE_URL_UNPOOLED is the
# direct one, used by `npm run migrate`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob for uploads. Leave empty locally to store uploads in ./media.
BLOB_READ_WRITE_TOKEN=

# Any long random string (`openssl rand -base64 32`).
PAYLOAD_SECRET=

# Public base URL, used for admin links, the sitemap and canonical tags.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
